    "Самые тяжёлые файлы и пакеты. Решайте сами, что из этого ещё нужно.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثقل الملفات والحزم. أنت من يقرّر ما الذي ما زال لازمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die größten Dateien und Pakete. Du entscheidest, was noch gebraucht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The heaviest files and packages. You decide what is still needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos y paquetes más pesados. Tú decides qué sigue haciendo falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers et paquets les plus lourds. À vous de décider ce qui est encore utile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे भारी फ़ाइलें और पैकेज। क्या अब भी चाहिए, यह आप तय करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file e i pacchetti più pesanti. Decidi tu cosa serve ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も容量の大きいファイルとパッケージ。何が必要かはご自身で判断してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 용량이 큰 파일과 패키지. 무엇이 아직 필요한지는 직접 판단하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos e pacotes mais pesados. Você decide o que ainda é necessário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占用空间最大的文件和软件包。由你决定哪些还需要。"
