            "value": "%@のキャッシュ。自動的に再作成されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 캐시, 자동으로 다시 만들어집니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache do %@; é recriado automaticamente"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 缓存，会自动重新生成"
          }
        }
      }
    },
    "Кэш инструмента командной строки. Скачанные модели и браузеры придётся загрузить заново": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة مؤقتة لأداة سطر الأوامر. النماذج والمتصفحات التي نُزّلت يجب تنزيلها من جديد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache eines Kommandozeilen-Tools. Geladene Modelle und Browser müssen erneut geladen werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache of a command-line tool. Downloaded models and browsers will have to be fetched again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché de una herramienta de línea de comandos. Los modelos y navegadores descargados habrá que bajarlos de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache d’un outil en ligne de commande. Les modèles et navigateurs téléchargés devront l’être à nouveau"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड-लाइन टूल का कैश। डाउनलोड किए मॉडल और ब्राउज़र दोबारा डाउनलोड करने होंगे"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache di uno strumento da riga di comando. Modelli e browser scaricati andranno riscaricati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドラインツールのキャッシュ。ダウンロード済みのモデルやブラウザは再ダウンロードが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령줄 도구의 캐시. 내려받은 모델과 브라우저는 다시 받아야 합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de uma ferramenta de linha de comando. Modelos e navegadores baixados terão de ser baixados de novo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令行工具的缓存。已下载的模型和浏览器需要重新下载"
          }
        }
      }
    },
    "Кэш пакетов %@ — загрузится заново": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة حزم %@ المؤقتة، تُنزَّل من جديد عند الحاجة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Paketcache, wird bei Bedarf erneut geladen"
          }
        },
        "en": {
          "stringUnit": {
