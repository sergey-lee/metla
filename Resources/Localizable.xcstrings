          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando as datas da última abertura…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在核对上次打开日期…"
          }
        }
      }
    },
    "Файл прошивки — после обновления устройства не нужен": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف برنامج ثابت، لا حاجة إليه بعد تحديث الجهاز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware-Datei, nach dem Update des Geräts nicht mehr nötig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware file, not needed once the device is updated"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo de firmware; no hace falta tras actualizar el dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier de firmware, inutile une fois l’appareil mis à jour"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़र्मवेयर फ़ाइल, डिवाइस अपडेट होने के बाद ज़रूरत नहीं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File del firmware, non serve dopo l’aggiornamento del dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファームウェアファイル。デバイスのアップデート後は不要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펌웨어 파일, 기기 업데이트 후에는 필요 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo de firmware; não é necessário após atualizar o dispositivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固件文件，设备更新后不再需要"
          }
        }
      }
    },
    "Файлы останутся в Корзине, и их можно будет вернуть, пока она не очищена.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الملفات في سلة المهملات ويمكن استرجاعها ما دامت السلة لم تُفرغ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien bleiben im Papierkorb und lassen sich zurücklegen, bis du ihn leerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files stay in the Trash and can be put back until you empty it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos quedan en la Papelera y se pueden recuperar hasta que la vacíes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers restent dans la Corbeille et peuvent être récupérés tant qu’elle n’est pas vidée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें ट्रैश में रहेंगी और ट्रैश ख़ाली होने तक वापस लाई जा सकती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file restano nel Cestino e si possono recuperare finché non lo svuoti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはゴミ箱に残り、空にするまでは元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 휴지통에 남아 있으며, 비우기 전까지는 되돌릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos ficam no Lixo e podem ser recuperados até você esvaziá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会留在废纸篓中，清倒之前都可以放回原处。"
          }
        }
      }
    },
    "Файлы с полностью одинаковым содержимым. Сравнение идёт по содержимому, а не по имени.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات متطابقة المحتوى تمامًا. المقارنة بالمحتوى لا بالاسم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien mit exakt gleichem Inhalt. Verglichen wird der Inhalt, nicht der Name."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files with exactly the same contents. They are compared by content, not by name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos con contenido idéntico. Se comparan por contenido, no por nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers au contenu strictement identique. La comparaison porte sur le contenu, pas sur le nom."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिलकुल एक जैसी सामग्री वाली फ़ाइलें। तुलना नाम से नहीं, सामग्री से होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File con contenuto identico. Il confronto avviene sul contenuto, non sul nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が完全に同じファイル。名前ではなく内容で比較します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 완전히 같은 파일. 이름이 아니라 내용으로 비교합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos com conteúdo idêntico. A comparação é pelo conteúdo, não pelo nome."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容完全相同的文件。按内容而非文件名比对。"
          }
        }
      }
    },
    "Файлы, которые давно не открывались и не изменялись.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات لم تُفتح ولم تُعدَّل منذ مدة طويلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die lange nicht geöffnet oder geändert wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files that have not been opened or changed for a long time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos que llevan mucho tiempo sin abrirse ni modificarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers qui n’ont été ni ouverts ni modifiés depuis longtemps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसी फ़ाइलें जो लंबे समय से न खोली गईं, न बदली गईं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File che non vengono aperti né modificati da molto tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い間開かれても変更されてもいないファイル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오랫동안 열거나 수정하지 않은 파일."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos que não são abertos nem alterados há muito tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很久没有打开或修改过的文件。"
          }
        }
      }
    },
    "Чисто": {
