          }
        }
      }
    },
    "Локальный репозиторий Maven — загрузится заново, сборка будет дольше": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستودع Maven المحلي، يُنزَّل من جديد لكن البناء التالي سيستغرق وقتًا أطول"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Maven-Repository, wird erneut geladen, der Build dauert dann länger"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Maven repository, downloaded again but the next build takes longer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositorio local de Maven; se descarga de nuevo, pero la compilación tardará más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépôt Maven local, retéléchargé mais le prochain build sera plus long"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maven की लोकल रिपॉज़िटरी, दोबारा डाउनलोड होगी पर अगला बिल्ड ज़्यादा समय लेगा"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository locale di Maven, riscaricato ma la build richiederà più tempo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mavenのローカルリポジトリ。再ダウンロードされますが、次回のビルドに時間がかかります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Maven 로컬 저장소, 다시 내려받지만 다음 빌드가 오래 걸립니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositório local do Maven; é baixado de novo, mas o build demora mais"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Maven 本地仓库，会重新下载，但下次构建会更慢"
          }
        }
      }
    },
    "Медиатека целиком — в ней все ваши фото, музыка или проекты": {
      "localizations": {
