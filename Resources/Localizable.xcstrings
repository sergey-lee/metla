    "Выбрана другая папка. Для поиска мусора и остатков приложений нужна именно домашняя папка.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخترت مجلدًا آخر. يتطلب البحث عن الملفات غير اللازمة وبقايا التطبيقات المجلد الرئيسي نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Ordner wurde gewählt. Für Datenmüll und App-Überreste wird genau der Benutzerordner gebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different folder was chosen. Finding junk and app leftovers needs your home folder itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eligió otra carpeta. Para buscar archivos basura y restos de apps hace falta la carpeta de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre dossier a été choisi. Pour trouver les fichiers inutiles et les restes d’apps, il faut le dossier de départ lui-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरा फ़ोल्डर चुना गया। कचरा फ़ाइलें और ऐप के बचे हिस्से खोजने के लिए होम फ़ोल्डर ही चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata scelta un’altra cartella. Per trovare file inutili e residui delle app serve proprio la cartella Inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のフォルダが選択されました。不要ファイルとアプリの残骸を探すにはホームフォルダそのものが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 폴더가 선택되었습니다. 불필요한 파일과 앱 잔여 파일을 찾으려면 홈 폴더 자체가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pasta foi escolhida. Para encontrar arquivos inúteis e restos de apps é preciso a própria pasta de início."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择的是其他文件夹。查找垃圾文件和应用残留需要选择个人文件夹本身。"
          }
        }
      }
    },
