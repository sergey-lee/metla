            "state": "translated",
            "value": "ट्रैश ख़ाली करने पर जगह ख़ाली होगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio si libera quando svuoti il Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にすると空き領域が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우면 공간이 확보됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço será liberado ao esvaziar o Lixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清倒废纸篓后才会释放空间。"
