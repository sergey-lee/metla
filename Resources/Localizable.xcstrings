    "Нажмите «Сканировать». Ничего не удаляется, пока вы сами не выберете файлы и не подтвердите.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر «فحص». لا يُحذف شيء حتى تحدّد الملفات وتؤكّد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Scannen“. Nichts wird gelöscht, bevor du Dateien auswählst und bestätigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Scan. Nothing is removed until you select files and confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Analizar. No se elimina nada hasta que selecciones archivos y lo confirmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Analyser. Rien n’est supprimé tant que vous n’avez pas sélectionné des fichiers et confirmé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“स्कैन करें” पर क्लिक करें। जब तक आप फ़ाइलें चुनकर पुष्टि नहीं करते, कुछ भी नहीं हटाया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su Analizza. Nulla viene rimosso finché non selezioni i file e confermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「スキャン」をクリックしてください。ファイルを選択して確認するまで、何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘스캔’을 클릭하세요. 파일을 선택하고 확인하기 전에는 아무것도 삭제되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Analisar. Nada é removido até você selecionar os arquivos e confirmar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“扫描”。在你选择文件并确认之前，不会删除任何内容。"
          }
        }
      }
    },
    "Найдено для возможной очистки: %@": {
      "localizations": {
