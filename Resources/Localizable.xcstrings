          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum der letzten Nutzung wird geprüft …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking when files were last opened…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando las fechas de última apertura…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification des dates de dernière ouverture…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली बार खोलने की तारीख़ें जाँची जा रही हैं…"
          }
        },
        "it": {
          "stringUnit": {
