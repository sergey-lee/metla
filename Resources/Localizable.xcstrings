    "Внутренние данные приложения — удаление может его сломать": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات داخلية لتطبيق، وحذفها قد يعطّله"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interne App-Daten, Löschen kann die App beschädigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internal app data, removing it may break the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos internos de una app; eliminarlos puede dañarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données internes d’une app, les supprimer peut l’endommager"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप का अंदरूनी डेटा, हटाने से ऐप ख़राब हो सकता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati interni di un’app, rimuoverli può danneggiarla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの内部データ。削除するとアプリが壊れる可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 내부 데이터, 삭제하면 앱이 망가질 수 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados internos de um app; remover pode quebrá-lo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用内部数据，删除可能导致应用出错"
          }
        }
      }
    },
    "Временные файлы. Приложения создают их заново, первое открытие может быть чуть медленнее.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات مؤقتة. تعيد التطبيقات إنشاءها، وقد يكون أول تشغيل أبطأ قليلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Dateien. Apps legen sie neu an, der erste Start kann etwas langsamer sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary files. Apps recreate them, the first launch may be a little slower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos temporales. Las apps los vuelven a crear; la primera apertura puede ser algo más lenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires. Les apps les recréent, le premier lancement peut être un peu plus lent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्थायी फ़ाइलें। ऐप इन्हें दोबारा बना लेते हैं, पहली बार खुलने में थोड़ा समय लग सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File temporanei. Le app li ricreano, il primo avvio può essere un po’ più lento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時ファイル。アプリが再作成します。初回の起動が少し遅くなることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 파일. 앱이 다시 만들며, 처음 열 때 조금 느릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos temporários. Os apps os recriam; a primeira abertura pode ser um pouco mais lenta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时文件。应用会重新生成，首次打开可能稍慢。"
          }
        }
      }
    },
    "Все копии, кроме оригинала": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل النسخ ما عدا الأصل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Kopien außer dem Original"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Copies Except the Original"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las copias excepto el original"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les copies sauf l’original"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल को छोड़कर सभी कॉपी"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le copie tranne l’originale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナル以外のすべてのコピー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본을 제외한 모든 복사본"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as cópias, exceto o original"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除原件外的所有副本"
          }
        }
      }
    },
    "Всё содержимое Корзины будет удалено навсегда. Это действие нельзя отменить.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف كل ما في سلة المهملات نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesamte Inhalt des Papierkorbs wird endgültig gelöscht. Das lässt sich nicht widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the Trash will be deleted permanently. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el contenido de la Papelera se eliminará para siempre. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le contenu de la Corbeille sera supprimé définitivement. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश की सारी सामग्री हमेशा के लिए मिटा दी जाएगी। यह कार्रवाई वापस नहीं ली जा सकती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il contenuto del Cestino verrà eliminato definitivamente. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱の中身はすべて完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통의 모든 항목이 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o conteúdo do Lixo será apagado para sempre. Esta ação não pode ser desfeita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓中的所有内容将被永久删除。此操作无法撤销。"
          }
        }
      }
    },
    "Выберите домашнюю папку, чтобы Метла могла искать в ней лишние файлы.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدك الرئيسي ليتمكّن Metla من البحث فيه عن الملفات التي لم تعد بحاجة إليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deinen Benutzerordner, damit Metla darin nach überflüssigen Dateien suchen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your home folder so Metla can look for files you no longer need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu carpeta de inicio para que Metla pueda buscar archivos que ya no necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre dossier de départ pour que Metla puisse y chercher les fichiers inutiles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना होम फ़ोल्डर चुनें ताकि Metla उसमें फ़ालतू फ़ाइलें खोज सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella Inizio, così Metla potrà cercare i file che non ti servono più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Metlaが不要なファイルを探せるように、ホームフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Metla가 불필요한 파일을 찾을 수 있도록 홈 폴더를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
