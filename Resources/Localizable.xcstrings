    "Обычно нужны один раз. Проверьте, нет ли среди них важных.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلزم مرة واحدة غالبًا. تحقّق من عدم وجود شيء مهم بينها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist nur einmal gebraucht. Prüfe, ob etwas Wichtiges dabei ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually needed only once. Check that nothing important is among them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelen hacer falta una sola vez. Comprueba que no haya nada importante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiles une seule fois en général. Vérifiez qu’il n’y a rien d’important."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आम तौर पर एक ही बार काम आते हैं। देख लें कि इनमें कुछ ज़रूरी तो नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito servono una volta sola. Controlla che non ci sia nulla di importante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常は一度しか使いません。重要なものが含まれていないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통 한 번만 필요합니다. 중요한 것이 없는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em geral só servem uma vez. Confira se não há nada importante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常只用一次。请确认其中没有重要内容。"
          }
        }
      }
    },
