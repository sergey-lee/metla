    "Приложение (%@) и отмеченные связанные файлы будут перемещены в Корзину.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُنقل التطبيق (%@) والملفات المرتبطة المحدَّدة إلى سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App (%@) und die ausgewählten zugehörigen Dateien werden in den Papierkorb gelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app (%@) and the selected related files will be moved to the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app (%@) y los archivos relacionados seleccionados se moverán a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app (%@) et les fichiers associés sélectionnés seront placés dans la Corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप (%@) और चुनी गई संबंधित फ़ाइलें ट्रैश में भेज दी जाएँगी।"
