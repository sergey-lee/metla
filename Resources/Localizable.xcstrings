{
  "sourceLanguage": "ru",
  "strings": {
    "%@ · изменялось на этой неделе — возможно, ещё используется": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · تم تعديله هذا الأسبوع، وربما ما زال قيد الاستخدام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · diese Woche geändert, wird vielleicht noch verwendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · changed this week, may still be in use"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · modificado esta semana, quizá aún se use"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · modifié cette semaine, peut-être encore utilisé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · इस हफ़्ते बदला गया, शायद अब भी इस्तेमाल में है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · modificato questa settimana, forse ancora in uso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 今週変更あり。まだ使用中の可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 이번 주에 변경됨, 아직 사용 중일 수 있음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · alterado esta semana, talvez ainda esteja em uso"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 本周有改动，可能仍在使用"
          }
        }
      }
    },
