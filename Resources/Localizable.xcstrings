    },
    "Место освободится после очистки Корзины.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحرر المساحة بعد إفراغ سلة المهملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicherplatz wird frei, sobald der Papierkorb geleert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The space is freed once you empty the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio se liberará al vaciar la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace sera libéré une fois la Corbeille vidée."
