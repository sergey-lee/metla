    "Скачанные пакеты и зависимости. Загружаются заново при следующей установке.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حزم واعتماديات نُزّلت. تُنزَّل من جديد عند التثبيت التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Pakete und Abhängigkeiten. Sie werden bei der nächsten Installation erneut geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded packages and dependencies. They are fetched again on the next install."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes y dependencias descargados. Se bajan de nuevo en la próxima instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets et dépendances téléchargés. Ils sont retéléchargés à la prochaine installation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड किए गए पैकेज और डिपेंडेंसी। अगली इंस्टॉल पर दोबारा डाउनलोड होते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetti e dipendenze scaricati. Vengono riscaricati alla prossima installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済みのパッケージと依存関係。次回のインストール時に再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내려받은 패키지와 의존성. 다음 설치 때 다시 내려받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
