    "Язык интерфейса сменится после перезапуска.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتغيّر لغة الواجهة بعد إعادة التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache der Oberfläche ändert sich nach dem Neustart."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The interface language changes after a restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de la interfaz cambiará tras reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de l’interface changera après le redémarrage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरफ़ेस की भाषा दोबारा शुरू करने के बाद बदलेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua dell’interfaccia cambierà dopo il riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターフェイスの言語は再起動後に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스 언어는 다시 시작한 뒤에 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma da interface muda após reiniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面语言将在重新启动后更改。"
          }
        }
