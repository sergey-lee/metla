          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de paquets %@, retéléchargé au besoin"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का पैकेज कैश, ज़रूरत पड़ने पर दोबारा डाउनलोड होगा"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache dei pacchetti di %@, riscaricata quando serve"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のパッケージキャッシュ。必要なときに再ダウンロードされます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 패키지 캐시, 필요할 때 다시 내려받습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache de pacotes do %@; é baixado de novo quando necessário"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 软件包缓存，需要时会重新下载"
          }
        }
      }
    },
    "Кэш страниц, кода и графики внутри данных приложений. Вкладки, пароли и история не затрагиваются.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة مؤقتة للصفحات والشيفرة والرسوميات داخل بيانات التطبيقات. لا تُمسّ علامات التبويب ولا كلمات السر ولا السجل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten-, Code- und Grafik-Caches in den App-Daten. Tabs, Passwörter und Verlauf bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page, code and graphics caches kept inside app data. Tabs, passwords and history are not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés de páginas, código y gráficos dentro de los datos de las apps. Las pestañas, contraseñas y el historial no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de pages, de code et de graphismes dans les données des apps. Les onglets, mots de passe et l’historique ne sont pas touchés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप डेटा के अंदर पेज, कोड और ग्राफ़िक्स का कैश। टैब, पासवर्ड और हिस्ट्री को नहीं छुआ जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache di pagine, codice e grafica dentro i dati delle app. Pannelli, password e cronologia non vengono toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのデータ内にあるページ、コード、グラフィックのキャッシュ。タブ、パスワード、履歴には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 데이터 안의 페이지, 코드, 그래픽 캐시. 탭, 암호, 방문 기록은 건드리지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de páginas, código e gráficos dentro dos dados dos apps. Abas, senhas e histórico não são afetados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用数据中的页面、代码和图形缓存。不会影响标签页、密码和历史记录。"
          }
        }
      }
    },
