          }
        }
      }
    },
    "Чтобы переместить приложение в Корзину, разрешите доступ к папке «Программы».": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لنقل التطبيق إلى سلة المهملات، اسمح بالوصول إلى مجلد التطبيقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die App in den Papierkorb zu legen, erlaube den Zugriff auf den Ordner „Programme“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To move the app to the Trash, allow access to the Applications folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mover la app a la Papelera, permite el acceso a la carpeta Aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour placer l’app dans la Corbeille, autorisez l’accès au dossier Applications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को ट्रैश में भेजने के लिए ऐप्लिकेशन फ़ोल्डर का ऐक्सेस दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per spostare l’app nel Cestino, consenti l’accesso alla cartella Applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをゴミ箱に入れるには、「アプリケーション」フォルダへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 휴지통으로 옮기려면 응용 프로그램 폴더 접근을 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mover o app para o Lixo, permita o acesso à pasta Aplicativos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将应用移到废纸篓，请允许访问“应用程序”文件夹。"
          }
        }
      }
    },
    "Это само приложение «Метла» — удалить себя оно не может.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو Metla نفسه، ولا يمكنه حذف نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist Metla selbst, die App kann sich nicht selbst löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is Metla itself, and it cannot remove itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la propia Metla, y no puede eliminarse a sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit de Metla elle-même, elle ne peut pas se supprimer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ख़ुद Metla है, और यह अपने आप को नहीं हटा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è Metla stessa, non può rimuovere sé stessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはMetla自身です。自分自身は削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Metla 자체입니다. 스스로를 삭제할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o próprio Metla, e ele não pode remover a si mesmo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 Metla 本身，它无法删除自己。"
          }
        }
      }
    },
